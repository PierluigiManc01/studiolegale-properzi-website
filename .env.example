# Resend API key (server-side only, never exposed to the browser)
RESEND_API_KEY=re_xxxxxxxxx

# Public-facing sender shown to recipients. Requires the domain to be
# verified in the Resend dashboard (Domains > Add Domain).
RESEND_FROM_EMAIL="Studio Legale Properzi <properzi@studiolegale.it>"

# Real inbox that receives every message. Only read server-side in
# api/send-email.ts — never sent to the client, so site visitors only
# ever see RESEND_FROM_EMAIL.
RESEND_TO_EMAIL=vanessa.properzi@libero.it
